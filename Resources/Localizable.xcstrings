    "Yes! Long-press any image in the gallery and select 'Edit' to modify it with AI." : {
      "extractionState" : "stale",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja! Hold fingeren nede på et billede i galleriet, og vælg »Rediger« for at ændre det med AI."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja! Halte ein Bild in der Galerie gedrückt und wähle „Bearbeiten“, um es mit KI zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Sí! Mantén pulsada cualquier imagen de la galería y elige «Editar» para modificarla con IA."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kyllä! Paina pitkään mitä tahansa galleriassa olevaa kuvaa ja valitse ”Muokkaa”, niin voit muokata sitä tekoälyllä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oui ! Appuyez de manière prolongée sur une image de la galerie et choisissez « Modifier » pour la retoucher avec l'IA."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já! Haltu inni á hvaða mynd sem er í gallerí og veldu „Breyta“ til að breyta henni með gervigreind."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sì! Tieni premuta un'immagine nella galleria e scegli «Modifica» per ritoccarla con l'IA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "はい。ギャラリーで画像を長押しして「編集」を選ぶと、AIで変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네! 갤러리에서 이미지를 길게 누른 뒤 '편집'을 선택하면 AI로 수정할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja! Trykk lenge på et bilde i galleriet, og velg «Rediger» for å endre det med KI."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak! Przytrzymaj dowolny obraz w galerii i wybierz „Edytuj”, aby zmienić go dzięki AI."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sim! Toque e segure qualquer imagem da galeria e escolha «Editar» para modificá-la com IA."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja! Tryck länge på valfri bild i galleriet och välj ”Redigera” för att ändra den med AI."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以！在图库中长按任意图片，选择“编辑”即可用 AI 修改。"
          }
