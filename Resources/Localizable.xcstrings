    "Waiting for approval. Plus starts as soon as it is approved." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på godkendelse. Plus starter, så snart den er godkendt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warte auf Zustimmung. Plus startet, sobald sie erteilt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando aprobación. Plus empezará en cuanto se apruebe."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odotetaan hyväksyntää. Plus alkaa heti, kun se on hyväksytty."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente d'approbation. Plus démarre dès qu'elle est accordée."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bíður samþykkis. Plus hefst um leið og áskriftin er samþykkt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In attesa di approvazione. Plus partirà appena approvato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認待ちです。承認されるとPlusが始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "승인을 기다리는 중입니다. 승인되면 Plus가 시작돼요."
          }
        },
