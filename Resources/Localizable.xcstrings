          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profesjonalne zdjęcie portretowe, przywrócona stara zdjęcia, figurka 3D i więcej: po jednym dotknięciu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto profissional, foto antiga restaurada, figurinha 3D e muito mais: um toque cada."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett professionellt porträtt, ett restaurerat gammalt foto, en 3D-figur och mer: ett tryck var."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
