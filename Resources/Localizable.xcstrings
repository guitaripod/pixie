    "Change her hair into something wild, spiky volumetric" : {
      "extractionState" : "stale",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skift hendes hår til noget vildt, pigget og voluminøst"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Haare in etwas Wildes verwandeln, stachelig und voluminös"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia su cabello por algo salvaje, puntiagudo y voluminoso"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihda hänen hiuksensa johonkin villiin, piikikkääseen ja tuuheaan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transforme ses cheveux en quelque chose de sauvage, hérissé et volumineux"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breyttu hárinu hennar í eitthvað villt, broddótt og rúmmikið"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasforma i suoi capelli in qualcosa di selvaggio, spettinato e voluminoso"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "髪をワイルドでボリュームのあるスパイキーヘアに変えて"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "머리를 거칠고 뾰족한 볼륨 스타일로 바꿔줘"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endre håret hennes til noe vilt, pigget og voluminøst"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmień jej włosy na coś dzikiego, najeżonego i pełnego objętości"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mude o cabelo dela para algo selvagem, espetado e volumoso"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändra hennes hår till något vilt, taggigt och voluminöst"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把她的头发换成狂野蓬松的尖刺造型"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把她的頭髮換成狂野蓬鬆的尖刺造型"
          }
        }
      }
    },
