    "%@ free every day for the next %lld days. No sign-up, nothing to cancel." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gratis hver dag de næste %lld dage. Ingen tilmelding, intet at annullere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ gratis pro Tag für die nächsten %2$lld Tage. Ohne Anmeldung, nichts zu kündigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ gratis al día durante los próximos %2$lld días. Sin registro y sin nada que cancelar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ilmaiseksi joka päivä seuraavien %lld päivän ajan. Ei rekisteröitymistä, ei mitään peruutettavaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ offertes chaque jour pendant %2$lld jours. Sans inscription, rien à résilier."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er ókeypis á hverjum degi næstu %lld daga. Engin skráning og ekkert til að segja upp."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ gratis al giorno per i prossimi %2$lld giorni. Nessuna registrazione, niente da disdire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これから%2$lld日間、毎日%1$@まで無料。登録も解約も不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앞으로 %2$lld일 동안 매일 %1$@ 무료. 가입도 해지도 필요 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gratis hver dag de neste %lld dagene. Ingen registrering, ingenting å si opp."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ za darmo każdego dnia przez następne %2$lld dni. Bez rejestracji, nic do anulowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ grátis por dia nos próximos %2$lld dias. Sem cadastro e nada para cancelar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gratis varje dag de kommande %lld dagarna. Ingen registrering, inget att avbryta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接下来 %2$lld 天，每天免费 %1$@。无需注册，无需取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接下來 %2$lld 天，每天免費 %1$@。無需註冊，無需取消。"
          }
        }
      }
    },
