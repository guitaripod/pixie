    "Credits are the currency used to generate and edit images. Each operation costs a different amount based on quality and size." : {
      "extractionState" : "stale",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kreditter er valutaen til at generere og redigere billeder. Hver handling koster et forskelligt beløb, afhængigt af kvalitet og størrelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Credits sind die Währung zum Generieren und Bearbeiten von Bildern. Was ein Vorgang kostet, hängt von Qualität und Größe ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los créditos son la moneda con la que generas y editas imágenes. Cada operación cuesta una cantidad distinta según la calidad y el tamaño."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krediitit ovat valuutta, jolla kuvia generoidaan ja muokataan. Jokainen toiminto maksaa eri verran laadun ja koon mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les crédits sont la monnaie utilisée pour générer et modifier des images. Le coût de chaque opération dépend de la qualité et de la taille."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inneignir eru gjaldmiðillinn sem notaður er til að búa til og breyta myndum. Hver aðgerð kostar mismunandi eftir gæðum og stærð."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I crediti sono la valuta con cui generi e modifichi le immagini. Ogni operazione costa in base a qualità e dimensione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クレジットは画像の生成と編集に使う通貨です。1回あたりの消費量は品質とサイズによって変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "크레딧은 이미지를 생성하고 편집할 때 사용하는 화폐입니다. 작업마다 품질과 크기에 따라 소모량이 달라집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kreditter er valutaen for å generere og redigere bilder. Hver operasjon koster ulikt, avhengig av kvalitet og størrelse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kredyty to waluta służąca do generowania i edycji obrazów. Koszt każdej operacji zależy od jakości i rozmiaru."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créditos são a moeda usada para gerar e editar imagens. Cada operação custa um valor diferente conforme a qualidade e o tamanho."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krediter är valutan för att generera och redigera bilder. Varje åtgärd kostar olika mycket beroende på kvalitet och storlek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "积分是生成和编辑图片所用的货币。每次操作的消耗取决于质量和尺寸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點數是生成與編輯圖片所使用的貨幣。每次操作依品質與尺寸不同，消耗的點數也不同。"
          }
        }
      }
    },
