    "Keep editing with Plus, %lld edits every week, or with a pack that never expires." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bliv ved med at redigere med Plus, %lld redigeringer hver uge, eller med en pakke, der aldrig udløber."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeite weiter mit Plus, %lld Bearbeitungen pro Woche, oder mit einem Paket, das nie verfällt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue editando con Plus, %lld ediciones cada semana, o con un paquete que nunca caduca."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jatka muokkaamista Plus-tilauksella, %lld muokkausta joka viikko, tai paketilla, joka ei vanhene koskaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuez avec Plus, %lld retouches chaque semaine, ou avec un pack qui n'expire jamais."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haltu áfram að breyta með Plus, %lld breytingar á viku, eða með inneignarpakka sem rennur aldrei út."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continua con Plus, %lld modifiche ogni settimana, o con un pacchetto che non scade mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎週%lld回編集できるPlus、または期限のないパックで続けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매주 %lld회 편집할 수 있는 Plus나 기한 없는 팩으로 계속 편집하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsett å redigere med Plus, %lld redigeringer hver uke, eller med en pakke som aldri utløper."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edytuj dalej z Plus – %lld edycji co tydzień – albo z pakietem, który nigdy nie wygasa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue editando com o Plus, %lld edições por semana, ou com um pacote que nunca expira."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsätt redigera med Plus, %lld redigeringar varje vecka, eller med ett paket som upphör aldrig."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Plus（每周 %lld 次编辑）或永不过期的套餐继续编辑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
