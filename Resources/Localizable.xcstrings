    "Higher compression reduces file size but may lower image quality" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højere komprimering mindsker filstørrelsen, men kan sænke billedkvaliteten"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stärkere Komprimierung verkleinert die Datei, kann aber die Bildqualität mindern"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más compresión reduce el tamaño del archivo, pero puede bajar la calidad"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suurempi pakkaus pienentää tiedostokokoa, mutta voi heikentää kuvanlaatua"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une compression plus forte réduit la taille du fichier mais peut dégrader la qualité"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meiri þjöppun minnkar skráarstærðina en getur dregið úr myndgæðum"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una compressione maggiore riduce le dimensioni del file ma può abbassare la qualità"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圧縮を強めるとファイルは小さくなりますが、画質が下がることがあります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "압축을 높이면 파일 크기는 줄지만 화질이 떨어질 수 있습니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sterkere komprimering reduserer filstørrelsen, men kan gi lavere bildekvalitet"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Większa kompresja zmniejsza rozmiar pliku, ale może obniżyć jakość obrazu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais compressão reduz o tamanho do arquivo, mas pode piorar a qualidade"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högre komprimering minskar filstorleken men kan sänka bildkvaliteten"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "压缩越高文件越小，但画质可能下降"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壓縮越高，檔案越小，但畫質可能下降"
          }
        }
      }
    },
    "Higher quality produces more detailed images but costs more credits. Low quality is great for drafts and experiments, while high quality is best for final artwork." : {
      "extractionState" : "stale",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højere kvalitet giver mere detaljerede billeder, men koster flere kreditter. Lav kvalitet er god til udkast og eksperimenter, mens høj kvalitet er bedst til det færdige billede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhere Qualität liefert detailliertere Bilder, kostet aber mehr Credits. Niedrige Qualität eignet sich für Entwürfe und Experimente, hohe Qualität für das fertige Werk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más calidad da imágenes más detalladas, pero cuesta más créditos. La calidad baja va bien para bocetos y pruebas; la alta, para la obra final."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korkeampi laatu tuottaa yksityiskohtaisempia kuvia, mutta maksaa enemmän krediittejä. Matala laatu sopii luonnoksiin ja kokeiluihin, kun taas korkea laatu sopii parhaiten lopullisiin töihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une qualité supérieure donne des images plus détaillées mais coûte plus de crédits. La qualité basse est idéale pour les brouillons et les essais, la haute pour le rendu final."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meiri gæði skila nákvæmari myndum en kosta fleiri inneignir. Lág gæði henta vel fyrir drög og tilraunir, en há gæði eru best fyrir lokaverkið."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una qualità più alta produce immagini più dettagliate ma costa più crediti. La qualità bassa è perfetta per bozze ed esperimenti, quella alta per il risultato finale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "品質を上げるほど画像は精細になりますが、消費クレジットも増えます。低品質は下書きや試作に、高品質は仕上げに向いています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "품질이 높을수록 이미지가 정교해지지만 크레딧을 더 많이 씁니다. 낮음은 초안과 실험에, 높음은 최종 결과물에 알맞습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyere kvalitet gir mer detaljerte bilder, men koster flere kreditter. Lav kvalitet passer godt til utkast og eksperimenter, mens høy kvalitet er best for det endelige kunstverket."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyższa jakość daje bardziej szczegółowe obrazy, ale kosztuje więcej kredytów. Niska jakość sprawdza się w szkicach i eksperymentach, a wysoka w finalnych pracach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais qualidade gera imagens mais detalhadas, mas consome mais créditos. A qualidade baixa é ótima para rascunhos e testes; a alta, para o resultado final."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högre kvalitet ger mer detaljerade bilder men kostar fler krediter. Låg kvalitet passar bra för utkast och experiment, medan hög kvalitet är bäst för färdiga bilder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "质量越高，细节越丰富，消耗的积分也越多。低质量适合打草稿和试验，高质量适合最终成品。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "品質越高，圖片細節越豐富，消耗的點數也越多。低品質適合打草稿與試驗，高品質最適合完稿作品。"
          }
        }
      }
    },
