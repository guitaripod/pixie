    "The model couldn't make this one. Try rewording it; its safety filter sometimes blocks photos of people. You weren't charged." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modellen kunne ikke lave dette. Prøv at formulere den om; dens sikkerhedsfilter blokerer nogle gange fotos af personer. Du blev ikke opkrævet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Modell konnte dieses Bild nicht erstellen. Formuliere es um; sein Sicherheitsfilter blockiert manchmal Fotos von Personen. Dir wurde nichts berechnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo no pudo crear este. Intenta reformularlo; su filtro de seguridad a veces bloquea fotos de personas. No te cobramos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malli ei pystynyt luomaan tätä kuvaa. Muotoile kehote uudelleen, sillä sen suojaussuodatin estää joskus ihmisten valokuvat. Sinulta ei veloitettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle n'a pas pu créer celui-ci. Essayez de le reformuler; son filtre de sécurité bloque parfois les photos de personnes. Vous n'avez pas été facturé."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Líkaninu tókst ekki að búa til þessa mynd. Prófaðu að orða hana aftur; öryggissían þess lokar stundum á myndir af fólki. Ekkert var tekið af inneignum þínum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modello non ha potuto creare questa immagine. Prova a riformularla; il suo filtro di sicurezza a volte blocca le foto di persone. Non ti è stato addebitato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルがこれを作成できませんでした。別の言い方で試してください。安全フィルタが人の写真をブロックすることがあります。料金は発生しませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델이 이것을 생성하지 못했습니다. 다시 표현해 보세요. 안전 필터가 사람의 사진을 차단하기도 합니다. 요금이 부과되지 않았습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modellen klarte ikke å lage dette bildet. Prøv å formulere det på nytt; sikkerhetsfilteret blokkerer noen ganger bilder av personer. Du ble ikke belastet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model nie mógł utworzyć tego obrazu. Spróbuj przeformułować opis; jego filtr bezpieczeństwa czasami blokuje zdjęcia osób. Nie pobrano opłaty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modelo não conseguiu criar este. Tente reformular; seu filtro de segurança às vezes bloqueia fotos de pessoas. Você não foi cobrado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modellen kunde inte generera den här bilden. Formulera om prompten; säkerhetsfiltret blockerar ibland foton av personer. Du debiterades inte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型无法生成这个。试试重新表述；它的安全过滤器有时会屏蔽人物照片。您未被收费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型無法生成這個。試試重新表述；它的安全過濾器有時會屏蔽人物照片。您未被收費。"
          }
        }
      }
    },
