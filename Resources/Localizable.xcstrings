    "Sign in to back up your images and edits and use them on every device. You can keep using Pixie without an account." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log ind for at sikkerhedskopiere dine billeder og redigeringer og bruge dem på alle enheder. Du kan blive ved med at bruge Pixie uden konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich an, um deine Bilder und Bearbeitungen zu sichern und auf jedem Gerät zu nutzen. Pixie funktioniert auch ohne Konto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión para guardar tus imágenes y ediciones y usarlas en todos tus dispositivos. Puedes seguir usando Pixie sin cuenta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaudu sisään, niin voit varmuuskopioida kuvasi ja muokkauksesi sekä käyttää niitä kaikilla laitteilla. Pixietä voi käyttää edelleen ilman tiliä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous pour sauvegarder vos images et retouches et les utiliser sur tous vos appareils. Vous pouvez utiliser Pixie sans compte."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skráðu þig inn til að taka öryggisafrit af myndum og breytingum og nota þær á öllum tækjum. Þú getur haldið áfram að nota Pixie án aðgangs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi per salvare immagini e modifiche e usarle su tutti i dispositivi. Puoi continuare a usare Pixie senza account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインすると画像と編集回数をバックアップし、すべてのデバイスで使えます。アカウントなしでも使い続けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인하면 이미지와 편집 횟수를 백업하고 모든 기기에서 쓸 수 있어요. 계정 없이도 Pixie를 계속 사용할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logg på for å sikkerhetskopiere bildene og redigeringene dine og bruke dem på alle enheter. Du kan bruke Pixie uten konto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się, aby zachować obrazy i edycje oraz używać ich na każdym urządzeniu. Pixie działa też bez konta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre para fazer backup das suas imagens e edições e usá-las em todos os aparelhos. Você pode continuar usando o Pixie sem conta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logga in för att säkerhetskopiera dina bilder och redigeringar och använda dem på alla enheter. Du kan fortsätta använda Pixie utan konto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录即可备份图片和编辑次数，并在所有设备上使用。不登录也能继续使用 Pixie。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登入即可備份圖片和編輯次數，並在所有裝置上使用。不登入也能繼續使用 Pixie。"
          }
        }
      }
    },
