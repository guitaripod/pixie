    "Sign in with your preferred provider:\n• GitHub (recommended)\n• Google\n• Apple\n\nYour account syncs across all devices and with the CLI tool." : {
      "extractionState" : "stale",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log ind med den udbyder, du foretrækker:\n• GitHub (anbefalet)\n• Google\n• Apple\n\nDin konto synkroniseres på tværs af alle enheder og med CLI-værktøjet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich mit dem Anbieter deiner Wahl an:\n• GitHub (empfohlen)\n• Google\n• Apple\n\nDein Account wird auf allen Geräten und mit dem CLI-Tool synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con el proveedor que prefieras:\n• GitHub (recomendado)\n• Google\n• Apple\n\nTu cuenta se sincroniza en todos tus dispositivos y con la herramienta CLI."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaudu haluamasi palvelun kautta:\n• GitHub (suositeltu)\n• Google\n• Apple\n\nTilisi synkronoituu kaikilla laitteillasi ja CLI-työkalun kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous avec le fournisseur de votre choix :\n• GitHub (recommandé)\n• Google\n• Apple\n\nVotre compte se synchronise sur tous vos appareils et avec l'outil CLI."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skráðu þig inn með þeim þjónustuaðila sem þú vilt:\n• GitHub (mælt með)\n• Google\n• Apple\n\nAðgangurinn þinn samstillist á öllum tækjum og við CLI-verkfærið."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con il provider che preferisci:\n• GitHub (consigliato)\n• Google\n• Apple\n\nIl tuo account si sincronizza su tutti i dispositivi e con lo strumento CLI."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好きなプロバイダでサインインできます:\n• GitHub（推奨）\n• Google\n• Apple\n\nアカウントはすべてのデバイスとCLIツールで同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원하는 제공업체로 로그인하세요:\n• GitHub (권장)\n• Google\n• Apple\n\n계정은 모든 기기와 CLI 도구에서 동기화됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logg på med tjenesten du foretrekker:\n• GitHub (anbefalt)\n• Google\n• Apple\n\nKontoen din synkroniseres på alle enheter og med CLI-verktøyet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się przez wybranego dostawcę:\n• GitHub (zalecane)\n• Google\n• Apple\n\nTwoje konto synchronizuje się na wszystkich urządzeniach i z narzędziem CLI."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre com o provedor que preferir:\n• GitHub (recomendado)\n• Google\n• Apple\n\nSua conta sincroniza em todos os dispositivos e com a ferramenta de CLI."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logga in med din föredragna leverantör:\n• GitHub (rekommenderas)\n• Google\n• Apple\n\nDitt konto synkroniseras mellan alla enheter och med CLI-verktyget."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用你偏好的登录方式：\n• GitHub（推荐）\n• Google\n• Apple\n\n你的账户会在所有设备以及 CLI 工具之间同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用你偏好的登入方式：\n• GitHub（建議）\n• Google\n• Apple\n\n你的帳戶會在所有裝置以及 CLI 工具之間同步。"
          }
        }
      }
    },
