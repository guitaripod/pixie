    "Your credits, including any you bought, and every image you've made will be permanently deleted from our servers. This can't be undone." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine kreditter, også dem du har købt, og alle de billeder, du har lavet, slettes permanent fra vores servere. Det kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Credits, einschließlich aller gekauften, und jedes Bild, das du gemacht hast, werden dauerhaft von unseren Servern gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus créditos, incluidos los que compraste, y cada imagen que creaste se eliminarán permanentemente de nuestros servidores. No se puede deshacer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krediittisi, myös ostamasi, ja kaikki tekemäsi kuvat poistetaan palvelimiltamme pysyvästi. Tätä ei voi kumota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos crédits, y compris ceux que vous avez achetés, et chaque image que vous avez créée seront définitivement supprimés de nos serveurs. Ceci ne peut pas être annulé."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inneignirnar þínar, þar á meðal þær sem þú keyptir, og allar myndirnar sem þú hefur búið til verða varanlega eyddar af netþjónum okkar. Ekki er hægt að afturkalla það."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi crediti, inclusi quelli acquistati, e ogni immagine che hai creato verranno eliminati permanentemente dai nostri server. Non è possibile annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入したクレジットを含むすべてのクレジットと、作成したすべての画像は、当社のサーバーから永久に削除されます。これは元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구매한 크레딧과 생성한 모든 이미지가 서버에서 영구적으로 삭제될 것입니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kredittene dine, inkludert eventuelle kjøpte kreditter, og alle bildene du har generert, slettes permanent fra serverne våre. Dette kan ikke angres."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje kredyty, łącznie z tymi, które kupiłeś, i każdy obraz, który stworzyłeś, zostaną trwale usunięte z naszych serwerów. Tego nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus créditos, incluindo qualquer um que você comprou, e cada imagem que você fez será permanentemente deletada de nossos servidores. Isso não pode ser desfeito."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina krediter, inklusive eventuella köpta, och alla bilder du har skapat raderas permanent från våra servrar. Det går inte att ångra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的积分（包括已购买的积分）以及生成的所有图片将从我们的服务器上永久删除。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的點數（包括已購買的點數）以及生成的所有圖片將從我們的伺服器上永久刪除。此操作無法復原。"
          }
        }
      }
    },
