    "Plus every week, or a pack\nthat never expires." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus hver uge, eller en pakke\nder aldrig udløber."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus jede Woche oder ein Paket,\ndas nie verfällt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus cada semana, o un paquete\nque nunca caduca."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus joka viikko tai paketti,\njoka ei vanhene koskaan."
          }
