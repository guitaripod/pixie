    "Deep space spiral galaxy, vivid purples and teal stars" : {
      "extractionState" : "stale",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiralgalakse i det dybe rum, livlige lilla og turkise stjerner"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiralgalaxie im tiefen All, kräftige Lila- und Türkistöne bei den Sternen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galaxia espiral en el espacio profundo, morados vivos y estrellas turquesa"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syvän avaruuden spiraaligalaksi, eloisat violetit ja turkoosit tähdet"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galaxie spirale dans l'espace profond, violets vifs et étoiles turquoise"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spíralvetrarbraut í djúpgeimnum, skærfjólubláar og grænbláar stjörnur"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galassia a spirale nello spazio profondo, viola intensi e stelle color turchese"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深宇宙の渦巻銀河、鮮やかな紫とティール色の星々"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "심우주의 나선 은하, 선명한 보라색과 청록빛 별들"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiralgalakse i dypt verdensrom, kraftige lilla toner og turkise stjerner"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiralna galaktyka w głębokim kosmosie, intensywne fiolety i turkusowe gwiazdy"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galáxia espiral no espaço profundo, roxos vívidos e estrelas cor de verde-azulado"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiralgalax i djuprymden, starka lila och turkosa stjärnor"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深空螺旋星系，鲜艳紫色与青绿色星光"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深空螺旋星系，鮮豔紫色與青綠色星光"
          }
        }
      }
    },
