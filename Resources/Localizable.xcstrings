    "%lld edits every week and ideas for the photos you pick. Renews weekly until you cancel in Settings." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld redigeringer hver uge og idéer til de fotos, du vælger. Fornyes, indtil du annullerer i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Bearbeitungen pro Woche und Ideen für die Fotos, die du auswählst. Verlängert sich wöchentlich, bis du in den Einstellungen kündigst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld ediciones cada semana e ideas para las fotos que elijas. Se renueva semanalmente hasta que canceles en Ajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld muokkausta joka viikko ja ideoita valitsemillesi kuville. Uusiutuu, kunnes peruutat Asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld retouches chaque semaine et des idées pour les photos que vous choisissez. Renouvelé chaque semaine jusqu'à résiliation dans Réglages."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld breytingar á viku og hugmyndir fyrir myndirnar sem þú velur. Endurnýjast vikulega þar til þú segir upp í Stillingum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld modifiche ogni settimana e idee per le foto che scegli. Si rinnova ogni settimana finché non annulli in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎週%lld回の編集と、選んだ写真へのアイデア。設定で解約するまで毎週更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매주 %lld회 편집과 선택한 사진을 위한 아이디어. 설정에서 해지할 때까지 매주 갱신됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld redigeringer hver uke og ideer til fotoene du velger. Fornyes ukentlig til du sier opp i Innstillinger."
          }
        },
        "pl" : {
          "stringUnit" : {
