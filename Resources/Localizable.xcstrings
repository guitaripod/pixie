    "Making an image needs an internet connection. Images you've already saved to Photos stay available offline." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det kræver en internetforbindelse at lave et billede. Billeder, du allerede har gemt i Fotos, er stadig tilgængelige offline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die Bilderstellung ist eine Internetverbindung erforderlich. Bilder, die du bereits in Fotos gespeichert hast, bleiben offline verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hacer una imagen requiere una conexión a Internet. Las imágenes que ya has guardado en Fotos permanecen disponibles sin conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvan luominen vaatii internetyhteyden. Kuvat, jotka olet jo tallentanut Kuviin, ovat edelleen käytettävissä offline-tilassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La création d'une image nécessite une connexion Internet. Les images que vous avez déjà enregistrées dans Photos restent disponibles hors ligne."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Til að búa til mynd þarf nettengingu. Myndir sem þú hefur þegar vistað í Myndir eru áfram aðgengilegar án nettengingar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La creazione di un'immagine richiede una connessione Internet. Le immagini che hai già salvato in Foto rimangono disponibili offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像の作成はインターネット接続が必要です。既に「写真」に保存した画像はオフラインで利用可能です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지를 만들려면 인터넷 연결이 필요합니다. 사진에 이미 저장한 이미지는 오프라인으로 사용 가능합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildegenerering krever en internettforbindelse. Bilder du allerede har lagret i Bilder, er fortsatt tilgjengelige når du er frakoblet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tworzenie obrazu wymaga połączenia z Internetem. Obrazy już zapisane w Zdjęciach pozostają dostępne offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fazer uma imagem precisa de conexão com a internet. Imagens que você já salvou em Fotos permanecem disponíveis offline."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att skapa en bild kräver en internetanslutning. Bilder du redan har sparat i Bilder finns kvar offline."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成图片需要互联网连接。已保存到照片应用的图片可以离线使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成圖片需要網際網路連線。已儲存到照片應用的圖片可以離線使用。"
          }
        }
      }
    },
