    "A pro headshot, a restored old photo, a 3D figurine and more: one tap each." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et professionelt portræt, et restaureret gammelt foto, en 3D-figur og mere: ét tryk hver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein professionelles Porträt, ein restauriertes altes Foto, eine 3D-Figur und mehr: jeweils ein Tap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un retrato profesional, una foto vieja restaurada, una figurilla 3D y más: un toque cada uno."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ammattimainen muotokuva, restauroitu vanha valokuva, 3D-figuuri ja paljon muuta: jokainen yhdellä napautuksella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un portrait professionnel, une vieille photo restaurée, une figurine 3D et bien d'autres : un appui chacun."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atvinnuportrett, endurgerð gömul ljósmynd, 3D-smáfígúra og fleira: einn smellur hvert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una foto professionale, una vecchia foto restaurata, una figurina 3D e altro: un tocco ciascuno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロ並みのヘッドショット、復元された古い写真、3Dフィギュアなど：各1タップ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전문적인 헤드샷, 복원된 오래된 사진, 3D 피규어 등을 각각 한 번에 만들 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
