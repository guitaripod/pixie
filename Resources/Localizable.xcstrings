    "Edits you spend, buy or receive will show up here." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redigeringer, du bruger, køber eller modtager, vises her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeitungen, die du verbrauchst, kaufst oder erhältst, erscheinen hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecerán las ediciones que uses, compres o recibas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käyttämäsi, ostamasi tai saamasi muokkaukset näkyvät tässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les retouches utilisées, achetées ou reçues apparaîtront ici."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breytingar sem þú notar, kaupir eða færð birtast hér."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui compariranno le modifiche che usi, acquisti o ricevi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使った・購入した・受け取った編集回数がここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용하거나 구매하거나 받은 편집 횟수가 여기에 표시돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redigeringer du bruker, kjøper eller mottar vises her."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutaj pojawią się edycje wykorzystane, kupione lub otrzymane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As edições que você usar, comprar ou receber aparecerão aqui."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redigeringar du förbrukar, köper eller får visas här."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你使用、购买或获得的编辑次数会显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你使用、購買或獲得的編輯次數會顯示在這裡。"
          }
        }
      }
    },
    "Email %@ and we'll help you out." : {
      "localizations" : {
