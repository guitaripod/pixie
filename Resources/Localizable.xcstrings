    "Select 'Transparent' in the background options when generating images. This works best with isolated subjects like logos or products." : {
      "extractionState" : "stale",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg »Transparent« under baggrundsindstillingerne, når du genererer billeder. Det fungerer bedst med isolerede motiver, som logoer eller produkter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle beim Generieren unter „Hintergrund“ die Option „Transparent“. Am besten funktioniert das bei freigestellten Motiven wie Logos oder Produkten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige «Transparente» en las opciones de fondo al generar la imagen. Funciona mejor con sujetos aislados, como logotipos o productos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse kuvia generoidessasi taustavaihtoehdoista ”Läpinäkyvä”. Tämä toimii parhaiten erotettujen kohteiden, kuten logojen tai tuotteiden, kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez « Transparent » dans les options d'arrière-plan lors de la génération. Cela fonctionne mieux avec des sujets isolés comme des logos ou des produits."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veldu „Gegnsær“ í bakgrunnsvalkostunum þegar þú býrð til myndir. Þetta virkar best með einangruðum viðfangsefnum eins og lógóum eða vörum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli «Trasparente» tra le opzioni di sfondo durante la generazione. Funziona meglio con soggetti isolati come loghi o prodotti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像を生成するとき、背景オプションで「透明」を選びます。ロゴや商品など、被写体が単独の場合に最も効果的です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지를 생성할 때 배경 옵션에서 '투명'을 선택하세요. 로고나 제품처럼 피사체가 하나일 때 가장 잘 작동합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg «Transparent» under bakgrunnsalternativene når du genererer bilder. Dette fungerer best med isolerte motiver som logoer eller produkter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz „Przezroczyste” w opcjach tła podczas generowania obrazów. Najlepiej sprawdza się to w przypadku wyizolowanych obiektów, takich jak logo czy produkty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha «Transparente» nas opções de fundo ao gerar a imagem. Funciona melhor com objetos isolados, como logos ou produtos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj ”Transparent” bland bakgrundsalternativen när du genererar bilder. Det fungerar bäst med isolerade motiv som logotyper eller produkter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成图片时，在背景选项中选择“透明”。用于标志、产品等单一主体时效果最佳。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成圖片時，在背景選項中選擇「透明」。用於標誌、產品等單一主體時效果最好。"
          }
        }
      }
    },
