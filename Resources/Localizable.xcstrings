          }
        }
      }
    },
    "A small copy of the photo you pick goes to Anthropic's Claude, which suggests the edits. Pixie's servers keep no copy." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En lille kopi af det foto, du vælger, sendes til Anthropics Claude, som foreslår redigeringerne. Pixies servere gemmer ingen kopi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine kleine Kopie des gewählten Fotos geht an Claude von Anthropic, das die Bearbeitungen vorschlägt. Pixies Server behalten keine Kopie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia pequeña de la foto que elijas se envía a Claude, de Anthropic, que sugiere las ediciones. Los servidores de Pixie no guardan ninguna copia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pieni kopio valitsemastasi kuvasta lähetetään Anthropicin Claudelle, joka ehdottaa muokkaukset. Pixien palvelimet eivät säilytä kopiota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une petite copie de la photo choisie est envoyée à Claude, d'Anthropic, qui suggère les retouches. Les serveurs de Pixie n'en gardent aucune copie."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lítið afrit af myndinni sem þú velur fer til Claude frá Anthropic, sem stingur upp á breytingunum. Þjónar Pixie geyma ekkert afrit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una piccola copia della foto che scegli viene inviata a Claude di Anthropic, che suggerisce le modifiche. I server di Pixie non ne conservano alcuna copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだ写真の小さなコピーがAnthropicのClaudeに送信され、編集が提案されます。Pixieのサーバーにコピーは残りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 사진의 작은 사본이 Anthropic의 Claude로 전송되어 편집을 제안받아요. Pixie 서버에는 사본이 남지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En liten kopi av fotoet du velger, sendes til Anthropics Claude, som foreslår redigeringene. Pixies servere beholder ingen kopi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mała kopia wybranego zdjęcia trafia do Claude'a firmy Anthropic, który proponuje edycje. Serwery Pixie nie zachowują żadnej kopii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma cópia pequena da foto que você escolhe vai para o Claude, da Anthropic, que sugere as edições. Os servidores do Pixie não guardam nenhuma cópia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En liten kopia av fotot du väljer skickas till Anthropics Claude, som föreslår redigeringarna. Pixies servrar sparar ingen kopia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你所选照片的一份小尺寸副本会发送给 Anthropic 的 Claude，由它推荐编辑。Pixie 的服务器不保留副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你所選照片的一份小尺寸副本會傳送給 Anthropic 的 Claude，由它推薦編輯。Pixie 的伺服器不保留副本。"
          }
        }
      }
    },
