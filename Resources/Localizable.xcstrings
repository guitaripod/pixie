        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus toda semana, ou um pacote\nque nunca expira."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus varje vecka, eller ett paket\nsom upphör aldrig."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每周 Plus，\n或永不过期的套餐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每週 Plus，\n或永不過期的套組。"
          }
        }
      }
    },
    "Plus gives you %lld edits every week and renews until you cancel. A pack is bought once and never expires." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus giver dig %lld redigeringer hver uge og fornyes, indtil du annullerer. En pakke køber du én gang, og den udløber aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus gibt dir jede Woche %lld Bearbeitungen und verlängert sich, bis du kündigst. Ein Paket kaufst du einmal, es verfällt nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus te da %lld ediciones cada semana y se renueva hasta que lo canceles. Un paquete se compra una vez y nunca caduca."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus antaa sinulle %lld muokkausta joka viikko, ja se uusiutuu, kunnes peruutat. Paketti ostetaan kerran, eikä se vanhene koskaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus vous donne %lld retouches chaque semaine et se renouvelle jusqu'à résiliation. Un pack s'achète une fois et n'expire jamais."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus gefur þér %lld breytingar á viku og endurnýjast þar til þú segir upp. Inneignarpakka kaupir þú einu sinni og hann rennur aldrei út."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus ti dà %lld modifiche ogni settimana e si rinnova finché non annulli. Un pacchetto si compra una volta e non scade mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusは毎週%lld回の編集が使え、解約するまで更新されます。パックは買い切りで期限がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus는 매주 %lld회 편집을 제공하며 해지할 때까지 갱신돼요. 팩은 한 번 구매하면 기한이 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus gir deg %lld redigeringer hver uke og fornyes til du sier opp. En pakke kjøper du én gang, og den utløper aldri."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus daje %lld edycji co tydzień i odnawia się, dopóki nie anulujesz. Pakiet kupujesz raz i nigdy nie wygasa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Plus oferece %lld edições por semana e renova até você cancelar. Um pacote é comprado uma vez e nunca expira."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus ger dig %lld redigeringar varje vecka och förnyas tills du avbryter. Ett paket köps en gång och upphör aldrig."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus 每周提供 %lld 次编辑，持续续订直到你取消。套餐一次购买，永不过期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus 每週提供 %lld 次編輯，持續續訂直到你取消。套組一次購買，永不過期。"
          }
        }
      }
    },
