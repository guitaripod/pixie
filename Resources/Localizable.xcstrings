    "Pixie needs the internet once to set up your account. Check your connection and try again." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixie har brug for internet én gang for at oprette din konto. Tjek din forbindelse, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixie braucht einmal Internet, um dein Konto einzurichten. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixie necesita internet una vez para configurar tu cuenta. Revisa la conexión e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixie tarvitsee kerran internetyhteyden tilisi luomiseen. Tarkista yhteytesi ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixie a besoin d'Internet une fois pour configurer votre compte. Vérifiez votre connexion et réessayez."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixie þarf nettengingu einu sinni til að setja upp aðganginn þinn. Athugaðu tenginguna og reyndu aftur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixie ha bisogno di Internet una volta per configurare il tuo account. Controlla la connessione e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントの設定に一度だけインターネット接続が必要です。接続を確認してもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정을 설정하려면 한 번 인터넷 연결이 필요해요. 연결을 확인하고 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
