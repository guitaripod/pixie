    "Tap your balance to see every edit you've spent or received." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på din saldo for at se hver redigering, du har brugt eller modtaget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf dein Guthaben, um jede verbrauchte oder erhaltene Bearbeitung zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca tu saldo para ver cada edición usada o recibida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta saldoasi nähdäksesi kaikki käyttämäsi ja saamasi muokkaukset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez votre solde pour voir chaque retouche utilisée ou reçue."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ýttu á inneignina þína til að sjá hverja breytingu sem þú hefur notað eða fengið."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il saldo per vedere ogni modifica usata o ricevuta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残高をタップすると、使用・受け取った編集回数をすべて確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잔액을 탭하면 사용하거나 받은 편집 내역을 모두 볼 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på saldoen din for å se hver redigering du har brukt eller mottatt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij saldo, aby zobaczyć każdą wykorzystaną lub otrzymaną edycję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no saldo para ver cada edição usada ou recebida."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på ditt saldo för att se alla redigeringar du har förbrukat eller fått."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点余额即可查看每次使用或获得的编辑次数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下餘額即可查看每次使用或獲得的編輯次數。"
          }
        }
      }
    },
    "Two days left in your Pixie Week" : {
