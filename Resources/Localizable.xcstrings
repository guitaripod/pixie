    "Pay for what you create.\nNo subscription — ever." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betal for det, du skaber.\nIntet abonnement – nogensinde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahl nur, was du erstellst.\nKein Abo – niemals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga solo lo que creas.\nSin suscripción, nunca."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksat vain siitä, mitä luot.\nEi tilausta – koskaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payez ce que vous créez.\nAucun abonnement, jamais."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borgaðu fyrir það sem þú býrð til.\nEngin áskrift, aldrei."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paghi solo ciò che crei.\nNessun abbonamento, mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作った分だけのお支払い。\nサブスクは一切なし。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "만든 만큼만 결제하세요.\n구독은 절대 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betal for det du lager.\nIngen abonnement – noensinne."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Płać tylko za to, co tworzysz.\nBez subskrypcji, nigdy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pague pelo que você criar.\nSem assinatura, nunca."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betala för det du skapar.\nInget abonnemang, någonsin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创作多少，付多少。\n永不订阅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "創作多少，付多少。\n永遠不必訂閱。"
          }
        }
      }
    },
