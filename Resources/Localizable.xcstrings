    "Standard costs one edit, Max costs five. You can switch for any single edit in the composer." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard koster én redigering, Max koster fem. Du kan vælge for hver enkelt redigering i editoren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard kostet eine Bearbeitung, Max fünf. Im Editor kannst du für jede einzelne Bearbeitung wechseln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard cuesta una edición y Max cinco. Puedes cambiar en cada edición desde el editor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard maksaa yhden muokkauksen, Max viisi. Voit vaihtaa yksittäisen muokkauksen tasoa kehotekentässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard coûte une retouche, Max en coûte cinq. Vous pouvez changer à chaque retouche dans l'éditeur."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staðlað kostar eina breytingu, Hámark fimm. Þú getur skipt um gerð fyrir hverja einstaka breytingu í skrifreitnum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard costa una modifica, Max cinque. Puoi cambiare per ogni singola modifica nell'editor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardは1回、Maxは5回分です。編集ごとに入力欄で切り替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard는 1회, Max는 5회가 차감됩니다. 편집할 때마다 입력창에서 바꿀 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard koster én redigering, Maks koster fem. Du kan bytte for hver enkelt redigering i redigeringsvinduet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard kosztuje jedną edycję, Max pięć. Możesz zmienić przy każdej edycji w edytorze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard custa uma edição e Max custa cinco. Você pode trocar em cada edição no editor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard kostar en redigering, Max kostar fem. Du kan byta för varje enskild redigering i skrivfältet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard 消耗 1 次编辑，Max 消耗 5 次。每次编辑都可在输入栏中切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard 消耗 1 次編輯，Max 消耗 5 次。每次編輯都可在輸入欄中切換。"
          }
        }
      }
    },
