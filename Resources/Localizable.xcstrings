    "No, Pixie requires an internet connection to communicate with the AI servers for image generation." : {
      "extractionState" : "stale",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nej, Pixie kræver en internetforbindelse for at kommunikere med AI-serverne til billedgenerering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nein. Pixie braucht eine Internetverbindung, um für die Bildgenerierung mit den KI-Servern zu kommunizieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. Pixie necesita conexión a Internet para comunicarse con los servidores de IA y generar imágenes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei, Pixie vaatii internetyhteyden, jotta se voi viestiä tekoälypalvelimien kanssa kuvien luontia varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non. Pixie a besoin d'une connexion Internet pour communiquer avec les serveurs d'IA et générer les images."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nei, Pixie þarf nettengingu til að eiga samskipti við gervigreindarnetþjónana til myndsköpunar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. Pixie ha bisogno di una connessione a Internet per comunicare con i server IA e generare le immagini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いいえ。Pixieは画像生成のためにAIサーバーと通信するので、インターネット接続が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아니요. Pixie는 이미지를 생성하기 위해 AI 서버와 통신해야 하므로 인터넷 연결이 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nei, Pixie krever en internettforbindelse for å kommunisere med KI-serverne for bildegenerering."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie, Pixie wymaga połączenia z internetem, aby komunikować się z serwerami AI podczas generowania obrazów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não. O Pixie precisa de conexão com a internet para se comunicar com os servidores de IA e gerar as imagens."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nej, Pixie kräver en internetanslutning för att kommunicera med AI-servrarna för bildgenerering."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不能。Pixie 需要联网才能与 AI 服务器通信来生成图片。"
          }
