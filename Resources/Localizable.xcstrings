            "value" : "Inserisci un importo e un motivo validi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効な数量と理由を入力してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "올바른 수량과 사유를 입력해 주세요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angi et gyldig beløp og en grunn"
