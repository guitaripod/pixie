    "Sign in to back up your images and credits and use them on every device. You can keep using Pixie without an account." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log ind for at sikkerhedskopiere dine billeder og kreditter, så du kan bruge dem på alle enheder. Du kan blive ved med at bruge Pixie uden konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich an, um deine Bilder und Credits zu sichern und auf allen Geräten zu nutzen. Du kannst Pixie auch ohne Account verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión para hacer una copia de seguridad de tus imágenes y créditos y usarlos en todos los dispositivos. Puedes seguir usando Pixie sin una cuenta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaudu sisään, jotta voit varmuuskopioida kuvasi ja krediittisi ja käyttää niitä kaikilla laitteilla. Voit käyttää Pixietä ilman tiliä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous pour sauvegarder vos images et crédits et les utiliser sur tous les appareils. Vous pouvez continuer à utiliser Pixie sans compte."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skráðu þig inn til að taka öryggisafrit af myndunum þínum og inneignum og nota þær á hverju tæki. Þú getur áfram notað Pixie án aðgangs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi per eseguire il backup delle tue immagini e crediti e usarli su tutti i dispositivi. Puoi continuare a usare Pixie senza un account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像とクレジットをバックアップし、すべてのデバイスで使用するためにサインインします。アカウントがなくても引き続きPixieを使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인하여 이미지와 크레딧을 백업하고 모든 기기에서 사용하세요. 계정 없이 Pixie를 계속 사용할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logg på for å sikkerhetskopiere bildene og kredittene dine og bruke dem på alle enheter. Du kan fortsette å bruke Pixie uten konto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się, aby utworzyć kopię zapasową obrazów i kredytów oraz używać ich na każdym urządzeniu. Możesz nadal używać Pixie bez konta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre para fazer backup de suas imagens e créditos e usá-los em todos os aparelhos. Você pode continuar usando Pixie sem uma conta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logga in för att säkerhetskopiera dina bilder och krediter och använda dem på alla enheter. Du kan fortsätta använda Pixie utan konto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录以备份您的图片和积分，并在每台设备上使用它们。您可以在没有账户的情况下继续使用 Pixie。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登入以備份您的圖片和點數，並在每台設備上使用它們。您可以在沒有帳戶的情況下繼續使用 Pixie。"
          }
        }
      }
    },
