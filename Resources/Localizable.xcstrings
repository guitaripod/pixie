    "No. Pixie starts right away on this device. Sign in with Apple in Settings to back up your images and edits and use them on other devices." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nej. Pixie starter med det samme på denne enhed. Log ind med Apple i Indstillinger for at sikkerhedskopiere dine billeder og redigeringer og bruge dem på andre enheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nein. Pixie startet sofort auf diesem Gerät. Melde dich in den Einstellungen mit Apple an, um Bilder und Bearbeitungen zu sichern und auf anderen Geräten zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. Pixie empieza al instante en este dispositivo. Inicia sesión con Apple en Ajustes para guardar tus imágenes y ediciones y usarlas en otros dispositivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei. Pixie käynnistyy heti tällä laitteella. Kirjaudu Apple-tilillä Asetuksissa, niin voit varmuuskopioida kuvasi ja muokkauksesi sekä käyttää niitä muilla laitteilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non. Pixie démarre tout de suite sur cet appareil. Connectez-vous avec Apple dans Réglages pour sauvegarder images et retouches et les utiliser ailleurs."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nei. Pixie byrjar strax á þessu tæki. Skráðu þig inn með Apple í Stillingum til að taka öryggisafrit af myndum og breytingum og nota þær á öðrum tækjum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. Pixie funziona subito su questo dispositivo. Accedi con Apple in Impostazioni per salvare immagini e modifiche e usarle su altri dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いいえ。このデバイスですぐに使えます。設定でAppleでサインインすると、画像と編集回数をバックアップして他のデバイスでも使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아니요. 이 기기에서 바로 시작돼요. 설정에서 Apple로 로그인하면 이미지와 편집 횟수를 백업해 다른 기기에서도 쓸 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nei. Pixie starter med én gang på denne enheten. Logg på med Apple i Innstillinger for å sikkerhetskopiere bildene og redigeringene dine og bruke dem på andre enheter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie. Pixie działa od razu na tym urządzeniu. Zaloguj się przez Apple w Ustawieniach, aby zachować obrazy i edycje oraz używać ich na innych urządzeniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não. O Pixie começa na hora neste aparelho. Entre com a Apple nos Ajustes para fazer backup das imagens e edições e usá-las em outros aparelhos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nej. Pixie startar direkt på den här enheten. Logga in med Apple i Inställningar för att säkerhetskopiera dina bilder och redigeringar och använda dem på andra enheter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不需要。Pixie 在此设备上即开即用。在“设置”中通过 Apple 登录即可备份图片和编辑次数，并在其他设备上使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不需要。Pixie 在此裝置上即開即用。在「設定」中透過 Apple 登入即可備份圖片和編輯次數，並在其他裝置上使用。"
          }
        }
      }
    },
