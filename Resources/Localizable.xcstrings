          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixie potrzebuje internetu raz, aby skonfigurować konto. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
