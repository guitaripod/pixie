        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不行。Pixie 需要連上網路，才能與 AI 伺服器通訊來生成圖片。"
          }
        }
      }
    },
    "No. Pixie starts right away on this device. Sign in with Apple in Settings to back up your images and credits and use them on other devices." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nej. Pixie starter med det samme på denne enhed. Log ind med Apple i Indstillinger for at sikkerhedskopiere dine billeder og kreditter og bruge dem på andre enheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nein. Pixie startet direkt auf diesem Gerät. Melde dich mit Apple in den Einstellungen an, um deine Bilder und Credits zu sichern und auf anderen Geräten zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. Pixie comienza enseguida en este dispositivo. Inicia sesión con Apple en Ajustes para hacer una copia de seguridad de tus imágenes y créditos y usarlos en otros dispositivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei. Pixie käynnistyy heti tällä laitteella. Kirjaudu Apple-tilillä Asetuksissa, jos haluat varmuuskopioida kuvasi ja krediittisi ja käyttää niitä muilla laitteilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non. Pixie démarre immédiatement sur cet appareil. Connectez-vous avec Apple dans les Réglages pour sauvegarder vos images et crédits et les utiliser sur d'autres appareils."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nei. Pixie ræsist strax í þessu tæki. Skráðu þig inn með Apple í Stillingum til að taka öryggisafrit af myndunum þínum og inneignum og nota þau á öðrum tækjum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. Pixie si avvia subito su questo dispositivo. Accedi con Apple in Impostazioni per eseguire il backup delle tue immagini e crediti e usarli su altri dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いいえ。Pixieはこのデバイスですぐに開始します。設定でAppleでサインインして、画像とクレジットをバックアップし、他のデバイスで使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아니요. Pixie는 이 기기에서 즉시 시작됩니다. 설정에서 Apple로 로그인하여 이미지와 크레딧을 백업하고 다른 기기에서 사용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nei. Pixie starter med én gang på denne enheten. Logg på med Apple i Innstillinger for å sikkerhetskopiere bildene og kreditene dine og bruke dem på andre enheter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie. Pixie uruchamia się natychmiast na tym urządzeniu. Zaloguj się przez Apple w Ustawieniach, aby utworzyć kopię zapasową obrazów i kredytów oraz używać ich na innych urządzeniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não. Pixie começa na hora neste aparelho. Entre com Apple em Ajustes para fazer backup de suas imagens e créditos e usá-los em outros aparelhos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nej. Pixie startar direkt på den här enheten. Logga in med Apple i Inställningar för att säkerhetskopiera dina bilder och krediter och använda dem på andra enheter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不需要。Pixie 在此设备上立即启动。在设置中使用 Apple 登录，以备份您的图片和积分并在其他设备上使用它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不需要。Pixie 在此設備上立即啟動。在設定中使用 Apple 登入，以備份您的圖片和點數並在其他設備上使用它們。"
          }
        }
      }
    },
