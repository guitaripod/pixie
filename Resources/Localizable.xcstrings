    "Choose one from your library, or try the sample photo first." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg et fra dit fotobibliotek, eller prøv eksempelfotoet først."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eines aus deiner Mediathek oder probiere zuerst das Beispielfoto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una de tu biblioteca o prueba primero la foto de ejemplo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse kuva kuvakirjastostasi tai kokeile ensin esimerkkivalokuvaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez l'une de votre bibliothèque ou essayez d'abord la photo d'exemple."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veldu eina úr myndasafninu þínu, eða prófaðu fyrst sýnishornsljósmyndina."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una dalla tua libreria o prova prima la foto di esempio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリから1つを選択するか、まずサンプル写真をお試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이브러리에서 하나를 선택하거나 샘플 사진을 먼저 시도해 보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg ett fra biblioteket ditt, eller prøv eksempelfotoet først."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz z biblioteki lub najpierw spróbuj przykładowego zdjęcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma de sua biblioteca ou teste a foto de exemplo primeiro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj ett foto från ditt bildbibliotek, eller prova exempelfotot först."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从您的库中选择一张，或先尝试示例照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從您的圖庫中選擇一張，或先嘗試範例照片。"
          }
        }
      }
    },
