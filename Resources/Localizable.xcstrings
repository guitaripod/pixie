    "Please enter a valid amount and reason" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angiv et gyldigt beløb og en årsag"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib bitte einen gültigen Betrag und einen Grund an"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce una cantidad y un motivo válidos"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna kelvollinen määrä ja syy"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez un montant et un motif valides"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sláðu inn gilda upphæð og ástæðu"
          }
        },
        "it" : {
          "stringUnit" : {
