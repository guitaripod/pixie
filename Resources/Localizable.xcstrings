    "Ask for changes in plain words and each message edits your latest image." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bed om ændringer med almindelige ord, og hver besked redigerer dit seneste billede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fordere Änderungen in einfachen Worten an und jede Nachricht bearbeitet dein neuestes Bild."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide cambios con palabras simples y cada mensaje edita tu última imagen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerro muutoksista tavallisin sanoin, ja jokainen viesti muokkaa uusinta kuvaasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez des modifications en langage clair et chaque message modifie votre dernière image."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biddu um breytingar með venjulegum orðum og hvert skeyti breytir nýjustu myndinni þinni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi cambiamenti con parole semplici e ogni messaggio modifica la tua immagine più recente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更をシンプルな言葉でリクエストすれば、各メッセージが最新の画像を編集します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평문으로 변경을 요청하면 각 메시지가 최신 이미지를 편집합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be om endringer med vanlige ord, og hver melding redigerer det nyeste bildet ditt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poproś o zmiany zwykłymi słowami i każda wiadomość edytuje Twój ostatni obraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça alterações em palavras simples e cada mensagem edita sua imagem mais recente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be om ändringar med vanliga ord, och varje meddelande redigerar din senaste bild."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用简单的语言请求更改，每条消息都会编辑您的最新图片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用簡單的文字要求更改，每條訊息都會編輯您最新的圖片。"
          }
        }
      }
    },
    "Ask for changes in plain words, and each message edits your latest image. Or describe a brand-new picture from scratch." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bed om ændringer med almindelige ord, og hver besked redigerer dit seneste billede. Eller beskriv et helt nyt billede fra bunden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fordere Änderungen in einfachen Worten an – jede Nachricht bearbeitet dein neuestes Bild. Oder beschreibe ein komplett neues Bild von Grund auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide cambios con tus propias palabras: cada mensaje edita tu última imagen. O describe una imagen completamente nueva desde cero."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerro muutoksista tavallisin sanoin: jokainen viesti muokkaa uusinta kuvaasi. Tai kuvaile aivan uusi kuva alusta alkaen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez des modifications avec vos propres mots : chaque message modifie votre dernière image. Ou décrivez une toute nouvelle image en partant de zéro."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biddu um breytingar með venjulegum orðum, og hvert skeyti breytir nýjustu myndinni þinni. Eða lýstu alveg nýrri mynd frá grunni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi modifiche a parole tue: ogni messaggio modifica la tua ultima immagine. Oppure descrivi un'immagine completamente nuova da zero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "普通の言葉で変更をお願いするだけで、メッセージごとに最新の画像が編集されます。または、新しい画像をゼロから説明して作成することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평범한 말로 변경을 요청하면 메시지마다 최신 이미지가 수정됩니다. 또는 완전히 새로운 이미지를 처음부터 설명해 보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be om endringer med vanlige ord, så redigerer hver melding det nyeste bildet ditt. Eller beskriv et helt nytt bilde fra bunnen av."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poproś o zmiany zwykłymi słowami – każda wiadomość edytuje twój najnowszy obraz. Albo opisz zupełnie nowy obraz od podstaw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça alterações com suas próprias palavras: cada mensagem edita sua imagem mais recente. Ou descreva uma imagem totalmente nova do zero."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be om ändringar med vanliga ord, och varje meddelande redigerar din senaste bild. Eller beskriv en helt ny bild från grunden."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用简单的话描述修改需求，每条消息都会编辑你最新的图片。或者从头描述一张全新的图片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用簡單的話描述修改需求，每則訊息都會編輯你最新的圖片。或者從頭描述一張全新的圖片。"
          }
        }
      }
    },
