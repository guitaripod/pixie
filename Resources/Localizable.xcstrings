    "80s retro synthwave portrait, palm trees, miami sunset" : {
      "extractionState" : "stale",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "80'er retro synthwave-portræt, palmetræer, solnedgang i Miami"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retro-Synthwave-Porträt im 80er-Stil, Palmen, Sonnenuntergang über Miami"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retrato retro synthwave estilo años 80, palmeras, atardecer de Miami"
          }
