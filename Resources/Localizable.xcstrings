    "Nothing is charged. Try rewording your request, since safety filters sometimes block photos of people." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der bliver ikke opkrævet noget. Prøv at formulere din anmodning om, da sikkerhedsfiltre nogle gange blokerer fotos af personer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird nichts berechnet. Versuche, deine Anfrage umzuformulieren, da Sicherheitsfilter manchmal Fotos von Personen blockieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se cobra nada. Intenta reformular tu solicitud, ya que los filtros de seguridad a veces bloquean fotos de personas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinulta ei veloiteta mitään. Muotoile pyyntösi uudelleen, sillä turvasuodattimet estävät joskus kuvat, joissa on ihmisiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n'est débité. Essayez de reformuler votre demande, car les filtres de sécurité bloquent parfois les photos de personnes."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engu er rukkað. Prófaðu að orða beiðnina aftur, því öryggissíur loka stundum á ljósmyndir af fólki."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non viene addebitato nulla. Prova a riformulare la tua richiesta, poiché i filtri di sicurezza a volte bloccano le foto di persone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何も課金されません。安全フィルタが人物の写真をブロックすることがあるため、リクエストを言い換えてみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청이 없습니다. 안전 필터가 사람 사진을 차단할 수 있으므로 요청을 다시 표현해 보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingenting belastes. Prøv å formulere forespørselen på nytt, siden sikkerhetsfiltre noen ganger blokkerer bilder av personer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic nie jest naliczane. Spróbuj przeformułować swoje żądanie, ponieważ filtry bezpieczeństwa czasami blokują zdjęcia osób."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada é cobrado. Tente reformular seu pedido, pois os filtros de segurança às vezes bloqueiam fotos de pessoas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga krediter dras. Försök formulera om din förfrågan, eftersom säkerhetsfilter ibland blockerar foton av personer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需收费。请尝试重新表述您的请求，因为安全过滤器有时会阻止人物照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無須收費。請嘗試重新表述您的要求，因為安全過濾器有時會阻止人物照片。"
          }
        }
      }
    },
    "Now make it a stunning deep-space galaxy with vivid nebulas" : {
      "extractionState" : "stale",
