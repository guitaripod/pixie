    "Each image costs edits: Standard costs one, Max costs five. The cost is shown before you make it." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert billede koster redigeringer: Standard koster én, Max koster fem. Prisen vises, før du laver det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Bild kostet Bearbeitungen: Standard eine, Max fünf. Die Kosten siehst du vorher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada imagen cuesta ediciones: Standard una y Max cinco. Verás el coste antes de crearla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen kuva maksaa muokkauksia: Standard maksaa yhden, Max viisi. Hinta näkyy ennen kuin luot kuvan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque image coûte des retouches : Standard une, Max cinq. Le coût s'affiche avant la création."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver mynd kostar breytingar: Staðlað kostar eina, Hámark fimm. Kostnaðurinn birtist áður en þú býrð hana til."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni immagine costa modifiche: Standard una, Max cinque. Il costo è indicato prima di crearla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像ごとに編集回数を使います。Standardは1回、Maxは5回。作成前に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지마다 편집 횟수가 차감돼요. Standard는 1회, Max는 5회이며 만들기 전에 표시돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert bilde koster redigeringer: Standard koster én, Maks koster fem. Kostnaden vises før du genererer det."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy obraz kosztuje edycje: Standard jedną, Max pięć. Koszt widzisz przed utworzeniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada imagem custa edições: Standard custa uma e Max custa cinco. O custo aparece antes de criar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje bild kostar redigeringar: Standard kostar en, Max kostar fem. Kostnaden visas innan du gör den."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每张图片消耗编辑次数：Standard 1 次，Max 5 次。生成前会显示消耗。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每張圖片消耗編輯次數：Standard 1 次，Max 5 次。生成前會顯示消耗。"
          }
        }
      }
    },
