        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con il provider che preferisci:\n• GitHub (consigliato)\n• Google\n• Apple\n\nIl tuo account si sincronizza su tutti i dispositivi e con lo strumento CLI."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好きなプロバイダでサインインできます:\n• GitHub（推奨）\n• Google\n• Apple\n\nアカウントはすべてのデバイスとCLIツールで同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원하는 제공업체로 로그인하세요:\n• GitHub (권장)\n• Google\n• Apple\n\n계정은 모든 기기와 CLI 도구에서 동기화됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
