    "Yes! Long-press any image in the gallery and select 'Edit' to modify it with AI." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja! Halte ein Bild in der Galerie gedrückt und wähle „Bearbeiten“, um es mit KI zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Sí! Mantén pulsada cualquier imagen de la galería y elige «Editar» para modificarla con IA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oui ! Appuyez de manière prolongée sur une image de la galerie et choisissez « Modifier » pour la retoucher avec l'IA."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sì! Tieni premuta un'immagine nella galleria e scegli «Modifica» per ritoccarla con l'IA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "はい。ギャラリーで画像を長押しして「編集」を選ぶと、AIで変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네! 갤러리에서 이미지를 길게 누른 뒤 '편집'을 선택하면 AI로 수정할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak! Przytrzymaj dowolny obraz w galerii i wybierz „Edytuj”, aby zmienić go dzięki AI."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sim! Toque e segure qualquer imagem da galeria e escolha «Editar» para modificá-la com IA."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
