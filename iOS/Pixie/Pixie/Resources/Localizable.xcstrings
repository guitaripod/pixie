    "Describe what you want in plain words. Refine it message by message and watch your image evolve — powered by Google Nano Banana and OpenAI." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschreib einfach in eigenen Worten, was du willst. Verfeinere es Nachricht für Nachricht und sieh zu, wie dein Bild entsteht – mit Google Nano Banana und OpenAI."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe lo que quieres con tus propias palabras. Refínalo mensaje a mensaje y verás cómo evoluciona tu imagen, con Google Nano Banana y OpenAI."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décrivez ce que vous voulez avec vos mots. Affinez message après message et regardez votre image évoluer — propulsé par Google Nano Banana et OpenAI."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descrivi ciò che vuoi con parole tue. Affinalo messaggio dopo messaggio e guarda la tua immagine evolvere, con Google Nano Banana e OpenAI."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作りたいものを普通の言葉で伝えるだけ。メッセージを重ねながら仕上げていけば、画像がどんどん理想に近づきます。Google Nano BananaとOpenAIを搭載。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원하는 것을 평범한 말로 설명하세요. 메시지를 주고받으며 다듬으면 이미지가 점점 완성됩니다. Google Nano Banana와 OpenAI 기반입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descreva o que você quer com suas palavras. Refine mensagem a mensagem e veja sua imagem evoluir — com Google Nano Banana e OpenAI."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用大白话说出你想要的画面，一句句地打磨，看着图片不断变好 —— 由 Google Nano Banana 与 OpenAI 驱动。"
          }
        }
      }
    },
