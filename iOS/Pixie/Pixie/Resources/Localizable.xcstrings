    "Pixie needs the internet once to set up your free images. Check your connection and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixie braucht einmalig Internet, um deine Gratis-Bilder einzurichten. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixie necesita internet una vez para preparar tus imágenes gratis. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixie a besoin d'Internet une fois pour préparer vos images offertes. Vérifiez votre connexion et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixie ha bisogno di internet una volta per preparare le tue immagini gratis. Controlla la connessione e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料の画像を準備するため、最初の1回だけインターネット接続が必要です。接続を確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료 이미지를 준비하려면 처음 한 번 인터넷에 연결해야 합니다. 연결을 확인한 후 다시 시도해 주세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixie potrzebuje internetu jednorazowo, aby przygotować Twoje darmowe zdjęcia. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Pixie precisa da internet uma vez para preparar suas imagens grátis. Verifique sua conexão e tente de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixie 需要联网一次来准备你的免费图片。请检查网络连接后重试。"
