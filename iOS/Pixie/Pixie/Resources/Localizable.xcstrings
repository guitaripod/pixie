        }
      }
    },
    "Your API keys are stored securely on your device. All images you generate are automatically shared to the public gallery. You can save images locally or share them to other apps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine API-Schlüssel werden sicher auf deinem Gerät gespeichert. Alle Bilder, die du generierst, werden automatisch in der öffentlichen Galerie geteilt. Du kannst Bilder lokal sichern oder in andere Apps teilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus claves de API se guardan de forma segura en tu dispositivo. Todas las imágenes que generas se comparten automáticamente en la galería pública. Puedes guardarlas en el dispositivo o compartirlas con otras apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos clés API sont stockées en toute sécurité sur votre appareil. Toutes les images que vous générez sont automatiquement partagées dans la galerie publique. Vous pouvez les enregistrer localement ou les partager vers d'autres apps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue chiavi API sono conservate in modo sicuro sul dispositivo. Tutte le immagini che generi vengono condivise automaticamente nella galleria pubblica. Puoi salvarle in locale o condividerle con altre app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "APIキーはデバイス内に安全に保存されます。生成した画像はすべて自動的にパブリックギャラリーで共有されます。画像は端末に保存したり、ほかのアプリに共有したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 키는 기기에 안전하게 저장됩니다. 생성한 모든 이미지는 자동으로 공개 갤러리에 공유됩니다. 이미지를 기기에 저장하거나 다른 앱으로 공유할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas chaves de API ficam guardadas com segurança no seu dispositivo. Todas as imagens que você gera são compartilhadas automaticamente na galeria pública. Você pode salvá-las localmente ou compartilhá-las com outros apps."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 API 密钥安全地保存在设备上。你生成的所有图片都会自动分享到公开图库。你可以把图片存到本地，或分享到其他 App。"
          }
        }
      }
    },
    "Your creations go public" : {
      "localizations" : {
        "de" : {
