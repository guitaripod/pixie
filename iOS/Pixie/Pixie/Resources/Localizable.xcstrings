    "Select 'Transparent' in the background options when generating images. This works best with isolated subjects like logos or products." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle beim Generieren unter „Hintergrund“ die Option „Transparent“. Am besten funktioniert das bei freigestellten Motiven wie Logos oder Produkten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige «Transparente» en las opciones de fondo al generar la imagen. Funciona mejor con sujetos aislados, como logotipos o productos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez « Transparent » dans les options d'arrière-plan lors de la génération. Cela fonctionne mieux avec des sujets isolés comme des logos ou des produits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli «Trasparente» tra le opzioni di sfondo durante la generazione. Funziona meglio con soggetti isolati come loghi o prodotti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像を生成するとき、背景オプションで「透明」を選びます。ロゴや商品など、被写体が単独の場合に最も効果的です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지를 생성할 때 배경 옵션에서 '투명'을 선택하세요. 로고나 제품처럼 피사체가 하나일 때 가장 잘 작동합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz „Przezroczyste” w opcjach tła podczas generowania obrazów. Najlepiej sprawdza się to w przypadku wyizolowanych obiektów, takich jak logo czy produkty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha «Transparente» nas opções de fundo ao gerar a imagem. Funciona melhor com objetos isolados, como logos ou produtos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成图片时，在背景选项中选择“透明”。用于标志、产品等单一主体时效果最佳。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
