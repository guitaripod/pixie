          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "はい。ギャラリーで画像を長押しして「編集」を選ぶと、AIで変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네! 갤러리에서 이미지를 길게 누른 뒤 '편집'을 선택하면 AI로 수정할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sim! Toque e segure qualquer imagem da galeria e escolha «Editar» para modificá-la com IA."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
