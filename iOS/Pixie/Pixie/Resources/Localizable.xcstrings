    "Photo library access denied. Please enable access in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugriff auf die Fotomediathek verweigert. Aktiviere ihn in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se denegó el acceso a la fototeca. Actívalo en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accès à la photothèque refusé. Autorisez-le dans les réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesso alla libreria foto negato. Attivalo in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真ライブラリへのアクセスが拒否されています。「設定」で許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 보관함 접근이 거부되었습니다. 설정에서 권한을 허용해 주세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odmówiono dostępu do biblioteki zdjęć. Włącz go w ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acesso à fototeca negado. Ative o acesso nos Ajustes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已拒绝访问照片图库。请在“设置”中开启权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已拒絕取用照片圖庫。請在「設定」中開啟權限。"
          }
        }
      }
    },
