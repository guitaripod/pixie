    "Ask for changes in plain words, and each message edits your latest image. Or describe a brand-new picture from scratch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fordere Änderungen in einfachen Worten an – jede Nachricht bearbeitet dein neuestes Bild. Oder beschreibe ein komplett neues Bild von Grund auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide cambios con tus propias palabras: cada mensaje edita tu última imagen. O describe una imagen completamente nueva desde cero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez des modifications avec vos propres mots : chaque message modifie votre dernière image. Ou décrivez une toute nouvelle image en partant de zéro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi modifiche a parole tue: ogni messaggio modifica la tua ultima immagine. Oppure descrivi un'immagine completamente nuova da zero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "普通の言葉で変更をお願いするだけで、メッセージごとに最新の画像が編集されます。または、新しい画像をゼロから説明して作成することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평범한 말로 변경을 요청하면 메시지마다 최신 이미지가 수정됩니다. 또는 완전히 새로운 이미지를 처음부터 설명해 보세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poproś o zmiany zwykłymi słowami – każda wiadomość edytuje twój najnowszy obraz. Albo opisz zupełnie nowy obraz od podstaw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça alterações com suas próprias palavras: cada mensagem edita sua imagem mais recente. Ou descreva uma imagem totalmente nova do zero."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用简单的话描述修改需求，每条消息都会编辑你最新的图片。或者从头描述一张全新的图片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用簡單的話描述修改需求，每則訊息都會編輯你最新的圖片。或者從頭描述一張全新的圖片。"
          }
        }
      }
    },
