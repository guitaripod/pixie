          }
        }
      }
    },
    "Report this image if it is offensive, unsafe, or violates the community guidelines. Reported images are reviewed and removed when they break the rules." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dieses Bild, wenn es beleidigend oder unsicher ist oder gegen die Community-Richtlinien verstößt. Gemeldete Bilder werden geprüft und bei Regelverstoß entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denuncia esta imagen si es ofensiva, insegura o incumple las normas de la comunidad. Las imágenes denunciadas se revisan y se eliminan si infringen las normas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signalez cette image si elle est choquante, dangereuse ou contraire aux règles de la communauté. Les images signalées sont examinées et retirées si elles enfreignent les règles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segnala questa immagine se è offensiva, pericolosa o viola le linee guida della community. Le immagini segnalate vengono esaminate e rimosse se infrangono le regole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不快な内容、危険な内容、またはコミュニティガイドラインに違反している画像は報告してください。報告された画像は確認のうえ、規約違反であれば削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 이미지가 불쾌하거나 위험하거나 커뮤니티 가이드라인을 위반한다면 신고해 주세요. 신고된 이미지는 검토 후 규정 위반 시 삭제됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denuncie esta imagem se ela for ofensiva, insegura ou violar as diretrizes da comunidade. Imagens denunciadas são revisadas e removidas quando infringem as regras."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果这张图片令人反感、不安全或违反社区准则，请举报。被举报的图片会经过审核，违规的将被移除。"
          }
        }
      }
    },
