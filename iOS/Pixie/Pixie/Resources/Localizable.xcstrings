    "You won't see posts from this account in Explore. You can manage blocked accounts in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beiträge dieses Accounts erscheinen nicht mehr unter „Entdecken“. Blockierte Accounts verwaltest du in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
