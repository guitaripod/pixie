        }
      }
    },
    "Yes! The backend supports using your own OpenAI API key. Contact support to set this up for your account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja! Das Backend unterstützt deinen eigenen OpenAI-API-Schlüssel. Wende dich an den Support, um das für deinen Account einzurichten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
