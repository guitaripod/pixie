    "Pay for what you create.\nNo subscription — ever." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahl nur, was du erstellst.\nKein Abo – niemals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga solo lo que creas.\nSin suscripción, nunca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payez ce que vous créez.\nAucun abonnement, jamais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paghi solo ciò che crei.\nNessun abbonamento, mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作った分だけのお支払い。\nサブスクは一切なし。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "만든 만큼만 결제하세요.\n구독은 절대 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Płać tylko za to, co tworzysz.\nBez subskrypcji, nigdy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pague pelo que você criar.\nSem assinatura, nunca."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创作多少，付多少。\n永不订阅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "創作多少，付多少。\n永遠不必訂閱。"
          }
        }
      }
    },
