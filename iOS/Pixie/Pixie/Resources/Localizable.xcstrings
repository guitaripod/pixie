    "This permanently deletes the image and removes it from the public gallery. This can't be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit wird das Bild endgültig gelöscht und aus der öffentlichen Galerie entfernt. Das lässt sich nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La imagen se eliminará de forma permanente y se quitará de la galería pública. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'image sera définitivement supprimée et retirée de la galerie publique. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'immagine verrà eliminata definitivamente e rimossa dalla galleria pubblica. L'operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像は完全に削除され、パブリックギャラリーからも取り除かれます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지가 영구적으로 삭제되고 공개 갤러리에서도 제거됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso apaga a imagem permanentemente e a remove da galeria pública. Não dá para desfazer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除该图片，并将其从公开图库中移除。此操作无法撤销。"
          }
        }
      }
    },
